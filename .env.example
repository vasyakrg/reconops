# Copy to .env and fill in. The compose file picks up everything from here.
# .env is gitignored — never commit secrets.

# ── Operator login ────────────────────────────────────────────────────────────
# The hub bcrypt-hashes the plaintext password at startup. If you'd rather
# hand out a pre-computed hash (e.g. for CI / config-management without ever
# storing the plaintext), set RECON_ADMIN_PASSWORD_HASH instead — it wins
# over RECON_ADMIN_PASSWORD when both are set. Generate a hash with:
#   docker compose run --rm --no-deps --entrypoint /usr/local/bin/recon-hub \
#     -e RECON_ADMIN_PASSWORD='strong-password' hub --mode gen-password-hash
RECON_ADMIN_USER=admin
RECON_ADMIN_PASSWORD=
# RECON_ADMIN_PASSWORD_HASH=

# ── LLM provider ──────────────────────────────────────────────────────────────
# Default backend is OpenRouter; any OpenAI-compatible endpoint works.
# Get a key at https://openrouter.ai/keys
RECON_LLM_API_KEY=
RECON_LLM_BASE_URL=https://openrouter.ai/api/v1
RECON_LLM_MODEL=anthropic/claude-sonnet-4.5
# Optional multi-model routing (summarizer/cheap/verifier tiers) lives in
# hub.yaml.llm.profiles — see the commented block in deploy/docker/hub.yaml.
# Each profile references its own api_key_env (reuse RECON_LLM_API_KEY or set
# a distinct env var per provider).
# Docker/lab default allows private/link-local HTTP router IPs. Public
# http:// provider URLs and HTTP hostnames are still rejected by the hub.
RECON_LLM_ALLOW_INSECURE_HTTP=true
# Route ALL outbound LLM-provider traffic (chat/completions + GET /models)
# through a forward proxy. Use this when the provider endpoint (e.g.
# api.cerebras.ai) is unreachable directly from the hub host — without it the
# request just hangs until the request timeout, so you see "neither a response
# nor an error". The proxy is configured as SEPARATE fields (not one URL):
#   RECON_LLM_PROXY_TYPE   http | https | socks5 | socks5h  (empty = no proxy)
#   RECON_LLM_PROXY_ADDR   host:port
#   RECON_LLM_PROXY_USER   optional proxy username
#   RECON_LLM_PROXY_PASS   optional proxy password (taken verbatim, no escaping)
# http/https = HTTP CONNECT proxy (proxy resolves DNS). socks5 / socks5h both
# resolve the target hostname on the proxy side (DNS-over-SOCKS). User/pass are
# never logged.
# RECON_LLM_PROXY_TYPE=socks5h
# RECON_LLM_PROXY_ADDR=127.0.0.1:1080
# RECON_LLM_PROXY_USER=
# RECON_LLM_PROXY_PASS=
# Per-request LLM HTTP timeout (default 120s). Slow/free reasoning models can
# exceed 120s on a full max_tokens generation, which surfaces as "read
# response: context deadline exceeded" and aborts the investigation step. Raise
# it for such models. Accepts a Go duration ("180s", "3m", "2m30s") or a bare
# integer of seconds ("180"). Beware: large values mean each step can hang for
# that long before failing.
# RECON_LLM_TIMEOUT=180s
# Token economy for huge log arrays: cap on the assembled collect /
# collect_batch / search_artifact result the model sees (default 2000;
# overrides hub.yaml.llm.max_result_tokens). Lower it to spend fewer tokens on
# fleet-wide log surveys. History demotion and token calibration are tuned in
# hub.yaml (history_keep_recent_results / history_demote_min_bytes); prompt
# caching is per-profile (supports_prompt_cache).
# RECON_LLM_MAX_RESULT_TOKENS=2000

# ── Hub certificate SANs ──────────────────────────────────────────────────────
# Comma-separated IP SANs for the hub server certificate. This overrides
# server.ip_addrs from hub.yaml. Changing SANs after the CA/server cert has
# been generated requires deleting/regenerating the CA directory.
RECON_HUB_IP_ADDRS=127.0.0.1

# ── Optional ──────────────────────────────────────────────────────────────────
# Set to "true" if you front the hub with nginx terminating TLS so the
# session cookie gets the Secure flag honouring X-Forwarded-Proto.
RECON_BEHIND_TLS_PROXY=false

# Structured-log verbosity for BOTH binaries (hub + agent): debug|info|warn|error.
# Unset/unrecognized → info. debug surfaces the per-decision auto-approve trail
# ([FIX:auto-approve]) on prod without a rebuild; the Debug sites carry no PII.
# RECON_LOG_LEVEL=info

# Override published ports if 8080 / 8443 / 9443 collide on the host.
# Hub UI is fronted by nginx; HTTPS=8443 is the operator entry point,
# HTTP=8080 is just a 301 → HTTPS.
# RECON_HTTP_PORT=8080
# RECON_HTTPS_PORT=8443
# RECON_GRPC_PORT=9443

# Marketing landing — separate container on its own ports. HTTPS=443 is
# the public entry point, HTTP=80 is a 301 → HTTPS.
# RECON_LANDING_HTTP_PORT=80
# RECON_LANDING_HTTPS_PORT=443
# RECON_LANDING_TLS_CN=reconops.ru

# CN baked into the auto-generated self-signed TLS cert on first nginx start.
# Set to your real hostname for non-localhost dev.
# RECON_TLS_CN=recon.local

# Quick install for new agents — drives /hosts "Quick install" form and the
# /install/agent.sh endpoint. RELEASE_REPO + GRPC_ENDPOINT must be set
# together; leave blank to disable the feature. Override the same fields
# in deploy/docker/hub.yaml `install:` if you prefer config files over env.
# RECON_INSTALL_RELEASE_REPO=https://github.com/vasyakrg/reconops
# RECON_INSTALL_GRPC_ENDPOINT=hub.example.com:9443
# RECON_INSTALL_VERSION=latest   # or a tag like "0.1.0"
# Public install URL — set when the operator browser path and the agent
# network path differ (e.g. orbstack on 443 vs published nginx on 8443).
# RECON_INSTALL_EXTERNAL_URL=https://hub.example.com:8443

# Self-hosted agent distribution — serve the agent tarball/checksums and a
# releases/latest JSON straight from the hub (no GitHub). When "true", the
# Quick-install one-liner and the agent self-updater are pointed at the hub's
# own /releases route; release_repo_url may be left blank. The bundled agent
# is baked into the hub image at build time, so set RECON_VERSION to a real
# semver (below) or the outdated badge can't compare versions.
# RECON_INSTALL_SELF_HOSTED=true
# Override only if the image bakes releases somewhere other than the default
# /usr/local/share/recon/releases.
# RECON_INSTALL_RELEASES_DIR=/usr/local/share/recon/releases

# Build-time version stamping (shown in the sidebar / login footer). MUST be a
# semver for self-hosted version-skew detection — a non-semver tag (incl. the
# "docker" default) collapses to 0.0.0 and disables the outdated badge.
# RECON_VERSION=0.1.0
# RECON_COMMIT=$(git rev-parse --short HEAD)
